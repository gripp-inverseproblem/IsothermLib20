repository-code: "https://github.com/gripp-inverseproblem/isotermlib20"
license: MIT
keywords:
  - adsorption isotherm
  - isotherm models
  - mass transfer
  - fixed-bed adsorption
  - numerical simulation
  - inverse problems
  - C++20
